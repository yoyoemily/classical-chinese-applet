<!-- 公告详情页 -->
<view class="page-ad">
  <view wx:if="{{loading}}" class="page-ad__loading">
    <text>加载中...</text>
  </view>

  <scroll-view
    wx:else
    class="page-ad__scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="page-ad__card">
      <view class="page-ad__header">
        <text class="page-ad__title">{{title}}</text>
        <text class="page-ad__time">{{displayTime}}</text>
      </view>
      <view class="page-ad__divider"></view>

      <block wx:for="{{paragraphs}}" wx:key="index">
        <view wx:if="{{index < paragraphs.length - 1}}" class="page-ad__p">
          <rich-text nodes="<p>{{item}}</p>"></rich-text>
        </view>
        <view wx:else class="page-ad__p--last">
          <rich-text nodes="<p>{{item}}</p>"></rich-text>
        </view>
      </block>
    </view>

    <view class="page-ad__bottom-placeholder"></view>
  </scroll-view>
</view>
